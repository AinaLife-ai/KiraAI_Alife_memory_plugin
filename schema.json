{
  "alife": {
    "type": "section",
    "name": "Alife 完整记忆移植",
    "collapsed": false,
    "fields": {
      "enabled": {
        "type": "switch",
        "name": "启用记忆系统",
        "default": true
      },
      "capture_enabled": {
        "type": "switch",
        "name": "记录对话与感知",
        "default": true
      },
      "auto_inject": {
        "type": "switch",
        "name": "持续上下文注入",
        "default": true
      },
      "threshold": {
        "type": "integer",
        "name": "首层压缩阈值",
        "default": 100,
        "minimum": 4,
        "maximum": 10000
      },
      "batch_size": {
        "type": "integer",
        "name": "首层每批条数",
        "default": 70,
        "minimum": 2,
        "maximum": 9999
      },
      "probability": {
        "type": "float",
        "name": "自动压缩概率",
        "default": 0.4,
        "minimum": 0,
        "maximum": 1
      },
      "max_level": {
        "type": "integer",
        "name": "最大压缩层级",
        "default": 8,
        "minimum": 1,
        "maximum": 32
      },
      "compress_model": {
        "type": "model_select",
        "name": "压缩模型",
        "default": "",
        "model_type": "llm"
      },
      "audit_model": {
        "type": "model_select",
        "name": "审计模型",
        "default": "",
        "model_type": "llm"
      },
      "embedding_model": {
        "type": "model_select",
        "name": "可选向量模型（启用后可能计费）",
        "default": "",
        "model_type": "embedding"
      },
      "semantic_enabled": {
        "type": "switch",
        "name": "启用向量检索（默认关闭）",
        "default": false
      },
      "audit_enabled": {
        "type": "switch",
        "name": "后台审计",
        "default": true
      },
      "audit_interval": {
        "type": "integer",
        "name": "审计间隔（秒）",
        "default": 1800,
        "minimum": 30,
        "maximum": 604800
      },
      "audit_batch": {
        "type": "integer",
        "name": "每批审计事实数",
        "default": 20,
        "minimum": 1,
        "maximum": 50
      },
      "model_timeout": {
        "type": "integer",
        "name": "模型超时（秒）",
        "default": 120,
        "minimum": 5,
        "maximum": 600
      },
      "model_retries": {
        "type": "integer",
        "name": "格式错误重试次数",
        "default": 2,
        "minimum": 0,
        "maximum": 4
      },
      "worker_count": {
        "type": "integer",
        "name": "后台并发数",
        "default": 2,
        "minimum": 1,
        "maximum": 4
      },
      "context_chars": {
        "type": "integer",
        "name": "上下文字符预算",
        "default": 24000,
        "minimum": 2000,
        "maximum": 500000
      },
      "token_warning": {
        "type": "integer",
        "name": "估算 Token 警告线",
        "default": 120000,
        "minimum": 1000,
        "maximum": 2000000
      },
      "recall_keywords": {
        "type": "list",
        "name": "回忆提示词",
        "default": [
          "记得",
          "之前",
          "上次",
          "曾经"
        ],
        "item_type": "string"
      },
      "recall_scope": {
        "type": "string",
        "name": "机器人可访问范围",
        "default": "session",
        "options": [
          "session",
          "linked",
          "global"
        ]
      },
      "top_k": {
        "type": "integer",
        "name": "感知事实批量（×10）",
        "default": 5,
        "minimum": 1,
        "maximum": 30
      },
      "proactive_enabled": {
        "type": "switch",
        "name": "定时主动感知",
        "default": false
      },
      "proactive_interval": {
        "type": "integer",
        "name": "主动感知间隔（秒）",
        "default": 3600,
        "minimum": 60,
        "maximum": 604800
      },
      "proactive_sessions": {
        "type": "list",
        "name": "主动感知会话",
        "default": [],
        "item_type": "string"
      },
      "compress_instruction": {
        "type": "string",
        "name": "压缩补充要求",
        "default": "以自身视角保留事件、感情、人物、关键事实和生活轨迹。精简但不要按珍贵程度丢弃线索；只依据输入，保留时间、否定、条件和不确定性。"
      },
      "auto_migrate": {
        "type": "switch",
        "name": "自动安全迁移旧记忆",
        "default": true
      },
      "mutual_exclusion": {
        "type": "switch",
        "name": "迁移成功后互斥旧插件",
        "default": true
      },
      "migration_max_chars": {
        "type": "integer",
        "name": "KiraOS 迁移字符上限",
        "default": 120,
        "minimum": 1,
        "maximum": 16000
      }
    }
  }
}
